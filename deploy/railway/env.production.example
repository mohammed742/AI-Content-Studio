# Template for the Clerk PRODUCTION values used by the Railway deploy.
#
# Copy to artifacts/web/.env.production.local (gitignored by `.env.*.local`),
# fill in the real values from the Clerk Dashboard, then:
#
#   ./deploy/railway/sync-env.sh --file artifacts/web/.env.production.local --apply
#
# Why a separate file from .env.local: Clerk production keys are locked to your
# custom domain and error out on localhost ("Production Keys are only allowed
# for domain ..."), so they cannot simply replace the dev values you develop
# against.
#
# Prerequisite: a Clerk production instance requires DNS records on a domain you
# control. A *.up.railway.app subdomain will not work — see DEPLOYMENT.md § 5.

# From Clerk Dashboard -> your production instance -> API keys.
# NOTE: the publishable key is inlined into the client bundle at BUILD time.
# Changing it requires a rebuild, not just a restart.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_
CLERK_SECRET_KEY=sk_live_

# From Clerk Dashboard -> Webhooks -> your production endpoint
# (https://<your-domain>/api/webhooks/clerk) -> Signing Secret.
# This is a DIFFERENT secret from the development instance's.
CLERK_WEBHOOK_SECRET=whsec_

# Everything else (DATABASE_URL, MUAPI_API_KEY, OPENAI_API_KEY, R2_*,
# CRON_SECRET) is unchanged between instances — push those from .env.local:
#
#   ./deploy/railway/sync-env.sh --apply --allow-test-keys
#
# is NOT the way to do that (it would push the test Clerk keys too). Instead
# copy the non-Clerk lines into this file as well, so one --file run sets
# everything consistently.
